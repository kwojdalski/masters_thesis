# Copy this file to .env and fill in the values you need.
# .env is gitignored; nothing you put there is ever committed.
#
# IMPORTANT: leave optional variables commented out rather than setting them
# to a blank value. python-dotenv treats `KEY=` as "set KEY to an empty
# string", which overrides the code's own default (e.g. RL_LOG_LEVEL=INFO)
# with "" instead of falling back to it -- for some variables that's a
# silent behavior change, for others (log level validation) it's a crash.
# Uncomment a line and give it a real value only when you want to override
# the default.

# --- Secrets / credentials -------------------------------------------------
# Required by the scripts that use them; all default to unset/empty, so
# leaving these blank (or commented out) is safe -- it just means the
# corresponding feature won't work until you fill it in.

# Used by scripts/how.py (project-aware LLM CLI helper)
ANTHROPIC_API_KEY=

# Used by databento-based market data fetching
DATABENTO_API_KEY=

# Used by scripts/download_stocks_from_gdrive.py, scripts/fetch_stocks.py,
# scripts/download_thesis_stock_data.py
GDRIVE_CLIENT_SECRET_FILE=
GDRIVE_SERVICE_ACCOUNT_FILE=
GDRIVE_STOCKS_URL=

# --- Experiment output & training pipeline ---------------------------------
# Root directory for structured per-run artifacts (results.json, checkpoints,
# benchmark tables, plots) written by train/evaluate.
# Default: logs
# EXPERIMENT_OUTPUT_DIR=logs

# --- MLflow ------------------------------------------------------------------
# Tracking store used by evaluate/train and thesis chapters.
# Default: sqlite:///mlflow.db
# MLFLOW_TRACKING_URI=sqlite:///mlflow.db

# --- Thesis (Quarto) rendering ----------------------------------------------
# Stamp build hash/date/size/font on every evaluation plot when rendering.
# AUDIT_PLOTS=1 uv run quarto render thesis/qmd/src/masters-thesis.qmd --to pdf
# AUDIT_PLOTS=1

# Show a provenance debug overlay (commit, datetime, source module) beneath
# pipeline-generated assets in the rendered thesis.
# THESIS_DEBUG_ASSETS=1

# --- Logging (logger package) -----------------------------------------------
# Root directory for rotating text logs (guardrails/train/eval .log captures).
# Separate from EXPERIMENT_OUTPUT_DIR above -- see docs/thesis_artifact_bridge.md.
# Default: logs
# RL_LOG_DIR=logs
# RL_LOG_LEVEL=INFO
# RL_LOG_MAX_SIZE=10485760
# RL_LOG_BACKUP_COUNT=5
# RL_CONSOLE_LOGS=true
# RL_COLORED_LOGS=true
# RL_STRUCTURED_LOGS=false

# Generic log filtering used ad hoc by some scripts.
# LOG_LEVEL=INFO
# LOG_REGEX=

# Read directly by src/order_book.py (bypasses the logger package's
# per-component config system, which is otherwise unused -- see below).
# ORDER_BOOK_LOG_DIR=logs
# ORDER_BOOK_LOG_LEVEL=INFO

# DATA_GENERATOR_LOG_LEVEL=INFO

# NOTE: logger/config.py also declares a COMPONENT_CONFIGS dict (tardis
# downloader, market_data_fetcher, pyth_downloader, dex_arbs,
# price_shift_cost, simulation, compare_oracles) and a get_component_config()
# / create_component_logger_config() API. None of it is called from
# anywhere else in the codebase as of this writing, so the corresponding
# *_LOG_LEVEL / *_STRUCTURED_LOGS env vars for those components are
# intentionally omitted here -- setting them would currently do nothing.

# --- Debugging ---------------------------------------------------------------
# TRADING_RL_DEBUG_FEATURES=1
