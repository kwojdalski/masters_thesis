{
  "permissions": {
    "allow": [
      "Bash(sed:*)",
      "Bash(find *)",
      "Bash(python3*)",
      "Bash(uv run python*)",
      "Bash(for *)"
    ]
  },
  "mcpServers": {
    "mlflow-mcp": {
      "command": "uv",
      "args": ["run", "--with", "mlflow>=3.4", "mlflow", "mcp", "run"],
      "env": {
        "MLFLOW_TRACKING_URI": "sqlite:///mlflow.db"
      }
    }
  }
}
